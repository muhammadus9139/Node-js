<!DOCTYPE html>
<html>

<head>
    <title>EJS Loop and Condition</title>
</head>


<body>

<h1>User List</h1>


<% users.forEach((user)=> { %>


    <h2>
        Name: <%= user.name %>
    </h2>


    <p>
        Age: <%= user.age %>
    </p>


    <% if(user.status === "Active") { %>

        <p>
            Status: User is Active
        </p>


    <% } else { %>

        <p>
            Status: User is Inactive
        </p>


    <% } %>


    <hr>


<% }) %>



</body>

</html>