<!DOCTYPE html>
<html>

<head>
    <title>Form with EJS</title>
</head>

<body>


<h1>User Form</h1>


<form action="/submit" method="POST">

    <label>
        Username:
    </label>

    <input 
    type="text" 
    name="username">


    <br><br>


    <label>
        Email:
    </label>

    <input 
    type="email" 
    name="email">


    <br><br>


    <button type="submit">
        Submit
    </button>


</form>


</body>

</html>