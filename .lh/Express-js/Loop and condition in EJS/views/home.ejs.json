            "name": "Commit-0",
            "content": "<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n    <title>EJS Loop and Condition</title>\r\n</head>\r\n\r\n\r\n<body>\r\n\r\n<h1>User List</h1>\r\n\r\n\r\n<% users.forEach((user)=> { %>\r\n\r\n\r\n    <h2>\r\n        Name: <%= user.name %>\r\n    </h2>\r\n\r\n\r\n    <p>\r\n        Age: <%= user.age %>\r\n    </p>\r\n\r\n\r\n    <% if(user.status === \"Active\") { %>\r\n\r\n        <p>\r\n            Status: User is Active\r\n        </p>\r\n\r\n\r\n    <% } else { %>\r\n\r\n        <p>\r\n            Status: User is Inactive\r\n        </p>\r\n\r\n\r\n    <% } %>\r\n\r\n\r\n    <hr>\r\n\r\n\r\n<% }) %>\r\n\r\n\r\n\r\n</body>\r\n\r\n</html>"
